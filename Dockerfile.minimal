# Minimal Dockerfile for debugging RunPod builds
# Use this if the main Dockerfile fails

FROM nvidia/cuda:12.1.0-base-ubuntu22.04

# Install Python and pip
RUN apt-get update && apt-get install -y \
    python3.10 \
    python3-pip \
    git \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /workspace

# Install core dependencies only
RUN pip3 install --no-cache-dir \
    torch==2.1.0 \
    transformers==4.36.0 \
    peft==0.9.0 \
    runpod>=1.7.0 \
    pycryptodome>=3.19.0 \
    safetensors>=0.4.0 \
    zstandard>=0.22.0

# Copy only essential files
COPY src/ /workspace/src/

# Test imports work
RUN python3 -c "import runpod; import torch; import transformers; print('All imports OK')"

# Start handler
CMD ["python3", "-u", "src/rp_handler.py"]
