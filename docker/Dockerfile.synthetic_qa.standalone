# Standalone Dockerfile for Synthetic Q&A Generator
# Can be built independently without entire project structure
# Usage: docker build -f docker/Dockerfile.synthetic_qa.standalone -t synthetic-qa-generator .
#
# Model: Qwen3-30B-A3B (MoE: 30.5B total, 3.3B activated)
# IMPORTANT: Mount a RunPod Network Volume at /runpod-volume for model caching

# Use RunPod's PyTorch image
# Note: Blackwell GPUs (sm_120) require PyTorch nightly or 2.6+ when released
FROM runpod/pytorch:2.4.0-py3.11-cuda12.4.1-devel-ubuntu22.04

WORKDIR /workspace

# Install system dependencies
RUN apt-get update && apt-get install -y \
    git \
    wget \
    curl \
    build-essential \
    libssl-dev \
    && rm -rf /var/lib/apt/lists/*

# Install Python dependencies
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir \
    # Core ML/AI
    torch>=2.5.0 \
    transformers>=4.46.0 \
    accelerate>=1.1.0 \
    bitsandbytes>=0.44.0 \
    safetensors>=0.4.5 \
    # Cryptography
    pycryptodome>=3.19.0 \
    cryptography>=41.0.0 \
    # PDF Processing
    pypdf>=4.0.0 \
    # RunPod
    runpod>=1.7.0 \
    # Qwen3 specific
    sentencepiece>=0.1.99 \
    protobuf>=4.25.0 \
    tokenizers>=0.15.0 \
    # Utilities
    python-dotenv>=1.0.0 \
    scipy>=1.11.0 \
    # Fast HuggingFace downloads
    hf_transfer>=0.1.0 && \
    # Reinstall torchvision to match PyTorch version (fixes nms operator error)
    pip install --no-cache-dir --force-reinstall torchvision --index-url https://download.pytorch.org/whl/cu124

# Copy only the handler file
COPY src/synthetic_qa_handler.py /workspace/src/synthetic_qa_handler.py

# Create __init__.py for src module
RUN mkdir -p /workspace/src && \
    touch /workspace/src/__init__.py

# Create startup script inline
RUN echo '#!/bin/bash\n\
set -e\n\
echo "=== Synthetic Q&A Handler Startup ==="\n\
if [ -d "/runpod-volume" ] && [ -w "/runpod-volume" ]; then\n\
    echo "✓ RunPod Network Volume detected"\n\
    mkdir -p /runpod-volume/huggingface/hub\n\
    export HF_HOME=/runpod-volume/huggingface\n\
    export TRANSFORMERS_CACHE=/runpod-volume/huggingface\n\
else\n\
    echo "⚠ No volume - using local cache"\n\
    export HF_HOME=/workspace/.cache/huggingface\n\
    export TRANSFORMERS_CACHE=/workspace/.cache/huggingface\n\
fi\n\
exec python3 -u src/synthetic_qa_handler.py' > /workspace/start.sh && \
    chmod +x /workspace/start.sh

# Environment variables for optimization
ENV TOKENIZERS_PARALLELISM=false
ENV PYTORCH_CUDA_ALLOC_CONF=max_split_size_mb:512

# Default to volume cache, startup script will adjust if not mounted
ENV HF_HOME=/runpod-volume/huggingface
ENV TRANSFORMERS_CACHE=/runpod-volume/huggingface
ENV HF_DATASETS_CACHE=/runpod-volume/huggingface/datasets
ENV HF_HUB_ENABLE_HF_TRANSFER=1

# Optimize for MoE models (Qwen3-30B-A3B)
ENV PYTORCH_NO_CUDA_MEMORY_CACHING=0
ENV CUDA_LAUNCH_BLOCKING=0

# Create necessary directories
RUN mkdir -p /workspace/outputs \
    /workspace/.cache/huggingface \
    /workspace/.cache/huggingface/models \
    /workspace/.cache/huggingface/datasets

# Health check for RunPod
HEALTHCHECK --interval=30s --timeout=10s --start-period=120s --retries=3 \
    CMD python3 -c "import runpod; import torch; import transformers; print('OK')" || exit 1

# For RunPod Serverless deployment
CMD ["/workspace/start.sh"]

