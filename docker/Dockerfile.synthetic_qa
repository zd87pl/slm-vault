# Dockerfile for Synthetic Q&A Generator (Qwen3-30B-A3B)
# Optimized for RunPod Serverless endpoint
# Model: Qwen3-30B-A3B (MoE: 30.5B total, 3.3B activated)
#
# IMPORTANT: Mount a RunPod Network Volume at /runpod-volume for model caching
# This prevents re-downloading the model on each cold start (~4GB download)

# Use RunPod's PyTorch image
# Note: Blackwell GPUs (sm_120) require PyTorch nightly or 2.6+ when released
# For now, using stable image - may need CPU fallback on Blackwell
FROM runpod/pytorch:2.4.0-py3.11-cuda12.4.1-devel-ubuntu22.04

WORKDIR /workspace

# Install system dependencies
RUN apt-get update && apt-get install -y \
    git \
    wget \
    curl \
    build-essential \
    libssl-dev \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements and install Python dependencies
COPY docker/requirements.txt /workspace/requirements.txt

# Install Python dependencies with optimizations for large models
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir -r requirements.txt && \
    pip install --no-cache-dir \
    sentencepiece>=0.1.99 \
    protobuf>=4.25.0 \
    tokenizers>=0.15.0 \
    hf_transfer>=0.1.0 && \
    # Reinstall torchvision to match PyTorch version (fixes nms operator error)
    pip install --no-cache-dir --force-reinstall torchvision --index-url https://download.pytorch.org/whl/cu124

# Copy application code (only src/ is required for synthetic QA handler)
COPY src/ /workspace/src/

# Copy startup script
COPY docker/start_qa_handler.sh /workspace/start_qa_handler.sh
RUN chmod +x /workspace/start_qa_handler.sh

# Environment variables for optimization
ENV TOKENIZERS_PARALLELISM=false
ENV PYTORCH_CUDA_ALLOC_CONF=max_split_size_mb:512

# Use RunPod Network Volume for persistent model cache (if mounted)
# Falls back to /workspace/.cache if no volume is mounted
ENV HF_HOME=/runpod-volume/huggingface
ENV TRANSFORMERS_CACHE=/runpod-volume/huggingface
ENV HF_DATASETS_CACHE=/runpod-volume/huggingface/datasets
ENV HF_HUB_ENABLE_HF_TRANSFER=1

# Optimize for MoE models (Qwen3-30B-A3B)
ENV PYTORCH_NO_CUDA_MEMORY_CACHING=0
ENV CUDA_LAUNCH_BLOCKING=0

# Create necessary directories (both volume and local fallback)
RUN mkdir -p /workspace/outputs \
    /workspace/.cache/huggingface \
    /workspace/.cache/huggingface/models \
    /workspace/.cache/huggingface/datasets

# Health check for RunPod
# Checks if RunPod and PyTorch are available
HEALTHCHECK --interval=30s --timeout=10s --start-period=120s --retries=3 \
    CMD python3 -c "import runpod; import torch; import transformers; print('OK')" || exit 1

# For RunPod Serverless deployment, start synthetic QA handler
# The startup script handles volume detection and cache setup
CMD ["/workspace/start_qa_handler.sh"]

