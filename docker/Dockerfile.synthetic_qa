# Dockerfile for Synthetic Q&A Generator (Qwen3-30B-A3B)
# Uses official vLLM image for reliable, fast inference
# Model: Qwen3-30B-A3B (MoE: 30.5B total, 3.3B activated)
#
# IMPORTANT: Mount a RunPod Network Volume at /runpod-volume for model caching
# This prevents re-downloading the model on each cold start (~4GB download)
#
# Performance:
# - With vLLM: ~2-5 minutes for 100 samples
# - Fallback to transformers if vLLM fails: ~15-20 minutes

# Use official vLLM image - guarantees vLLM works correctly
FROM vllm/vllm-openai:latest

WORKDIR /workspace

# Install additional dependencies for our handler
# vLLM image already has torch, transformers, etc.
RUN pip install --no-cache-dir \
    runpod>=1.7.0 \
    pycryptodome>=3.19.0 \
    pypdf>=4.0.0 \
    hf_transfer>=0.1.0 \
    bitsandbytes>=0.44.0

# Copy application code
COPY src/ /workspace/src/

# Copy startup script
COPY docker/start_qa_handler.sh /workspace/start_qa_handler.sh
RUN chmod +x /workspace/start_qa_handler.sh

# Environment variables for optimization
ENV TOKENIZERS_PARALLELISM=false

# Use RunPod Network Volume for persistent model cache (if mounted)
ENV HF_HOME=/runpod-volume/huggingface
ENV HF_HUB_CACHE=/runpod-volume/huggingface/hub
ENV HF_HUB_ENABLE_HF_TRANSFER=1

# Create fallback cache directories
RUN mkdir -p /workspace/.cache/huggingface/hub

# Health check - verify vLLM is available
HEALTHCHECK --interval=30s --timeout=10s --start-period=120s --retries=3 \
    CMD python3 -c "import runpod; import vllm; print('OK')" || exit 1

# Start the QA handler
CMD ["/workspace/start_qa_handler.sh"]

