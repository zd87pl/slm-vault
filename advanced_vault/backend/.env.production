# Production Environment Variables for Railway
# DO NOT commit this file with real values!

# Supabase Configuration (from Step 3 of Supabase setup)
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# JWT Configuration (from Supabase → Settings → API → JWT Settings)
JWT_SECRET=your-supabase-jwt-secret
JWT_ALGORITHM=HS256

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
ENVIRONMENT=production

# CORS Configuration
FRONTEND_URL=https://enclave-web.vercel.app
ALLOWED_ORIGINS=["https://enclave-web.vercel.app","https://yourdomain.com"]

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60

# Logging
LOG_LEVEL=INFO
